@inject SiteLocalization L

<header class="site-header">
    <div class="nav-shell container-shell">
        <a class="brand" href="@(HomePrefix + "#inicio")" aria-label="Ankh Digital - início" @onclick="CloseMenu">
            <span class="brand-mark" aria-hidden="true">☥</span>
            <span class="brand-copy"><strong>Ankh Digital</strong><small>@L.T("Soluções Tecnológicas")</small></span>
        </a>
        @if (IsLab)
        {
            <span class="lab-header-label"><strong>ANKH LAB</strong><small>@L.T("Laboratório interativo")</small></span>
        }
        <button class="menu-toggle" type="button" @onclick="ToggleMenu" aria-expanded="@_menuOpen.ToString().ToLowerInvariant()" aria-controls="main-navigation" aria-label="@L.T(_menuOpen ? "Fechar menu" : "Abrir menu")"><span></span><span></span><span></span></button>
        <nav id="main-navigation" class="main-nav @(_menuOpen ? "is-open" : null)" aria-label="@L.T("Navegação principal")">
            <a href="@(HomePrefix + "#inicio")" @onclick="CloseMenu">@L.T("Início")</a><a href="@(HomePrefix + "#servicos")" @onclick="CloseMenu">@L.T("Serviços")</a><a href="@(HomePrefix + "#projetos")" @onclick="CloseMenu">@L.T("Projetos")</a><a href="@(HomePrefix + "#sobre")" @onclick="CloseMenu">@L.T("Sobre")</a><a href="@(HomePrefix + "#contato")" @onclick="CloseMenu">@L.T("Contato")</a>
            <LanguageSelector />
            <a class="nav-cta" href="@(HomePrefix + "#contato")" @onclick="CloseMenu">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.372-.025-.521-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479s1.065 2.875 1.213 3.074c.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.29.173-1.414-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.981.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.002-5.45 4.436-9.884 9.892-9.884a9.82 9.82 0 0 1 7.021 2.91 9.82 9.82 0 0 1 2.9 7.019c-.002 5.45-4.436 9.884-9.929 9.884m8.413-18.297A11.82 11.82 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.88 11.88 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.82 11.82 0 0 0-3.48-8.413Z" />
                </svg>
                @L.T("Fale Conosco")
            </a>
        </nav>
    </div>
</header>

@code {
    [Parameter] public string HomePrefix { get; set; } = string.Empty;
    [Parameter] public bool IsLab { get; set; }
    private bool _menuOpen;
    private void ToggleMenu() => _menuOpen = !_menuOpen;
    private void CloseMenu() => _menuOpen = false;
}
